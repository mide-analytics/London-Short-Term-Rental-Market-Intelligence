{
  "compatibilityLevel": 1606,
  "model": {
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Listings\", \"Calendar Monthly\", \"Reviews Monthly\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      }
    ],
    "culture": "en-GB",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "discourageImplicitMeasures": true,
    "relationships": [
      {
        "name": "Calendar Monthly to Listings",
        "fromColumn": "Listing ID",
        "fromTable": "Calendar Monthly",
        "toColumn": "Listing ID",
        "toTable": "Listings"
      },
      {
        "name": "Reviews Monthly to Listings",
        "fromColumn": "Listing ID",
        "fromTable": "Reviews Monthly",
        "toColumn": "Listing ID",
        "toTable": "Listings"
      }
    ],
    "sourceQueryCulture": "en-GB",
    "tables": [
      {
        "name": "Listings",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "Listing ID",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "4327f146-04fc-597a-bcc7-298ec0922911",
            "sourceColumn": "listing_id",
            "summarizeBy": "none"
          },
          {
            "name": "Advertised Nightly GBP",
            "dataType": "decimal",
            "lineageTag": "1be7e12d-c63e-57f0-bf7e-2a24d54ac987",
            "sourceColumn": "advertised_nightly_gbp",
            "summarizeBy": "none"
          },
          {
            "name": "Host ID",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "a294ea4b-dde8-5ebc-83fa-642196ecbef6",
            "sourceColumn": "host_id",
            "summarizeBy": "none"
          },
          {
            "name": "Neighbourhood",
