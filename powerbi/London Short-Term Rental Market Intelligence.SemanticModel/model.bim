            "summarizeBy": "none"
          },
          {
            "name": "Observed Nights",
            "dataType": "int64",
            "lineageTag": "ffe74113-ef37-5d5d-97e3-a2e757601bba",
            "sourceColumn": "observed_nights",
            "summarizeBy": "none"
          },
          {
            "name": "Available Nights",
