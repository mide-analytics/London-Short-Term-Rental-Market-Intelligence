          }
        ],
        "lineageTag": "0650447e-abdc-5803-a3ce-d6237aa18a5a",
        "measures": [
          {
            "name": "Observed listing nights",
            "expression": "SUM('Calendar Monthly'[Observed Nights])",
            "formatString": "#,0",
            "lineageTag": "84e66177-0834-4d45-ba90-14aaf9dd87f2"
          },
          {
            "name": "Available listing nights",
            "expression": "SUM('Calendar Monthly'[Available Nights])",
            "formatString": "#,0",
            "lineageTag": "9d3748b1-9099-450f-80e8-e1e4983ae050"
          },
          {
            "name": "Calendar availability",
            "expression": "DIVIDE([Available listing nights], [Observed listing nights])",
            "formatString": "0.0%",
            "lineageTag": "c1a9a90c-c3f6-46be-8ac6-9d6e3ba4b1e5"
          }
        ],
        "partitions": [
          {
            "name": "Calendar Monthly",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:\\London Airbnb\\data\\processed\\calendar_monthly.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"listing_id\", type text}, {\"month\", type date}, {\"observed_nights\", Int64.Type}, {\"available_nights\", Int64.Type}}, \"en-GB\")",
                "in Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
